# انسخ هذا الملف لـ .env وعبّي القيم الحقيقية (أو حطهم مباشرة بلوحة تحكم
# منصة الاستضافة تبعتك — Render/Railway/Heroku كلهم بيدوك مكان لـ Environment Variables).
# ⚠️ لا ترفع ملف .env الحقيقي (فيه أسرار) لأي مكان عام — هو موجود بـ .gitignore أصلاً.

# ---- الأساسيات (إلزامية بالإنتاج) ----
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=CHANGE-ME-generate-a-real-random-50-char-secret-key
DJANGO_ALLOWED_HOSTS=lowcaloriesjordan.com,www.lowcaloriesjordan.com

# ---- قاعدة البيانات (PostgreSQL بالإنتاج، شكل الرابط القياسي) ----
DATABASE_URL=postgres://username:password@host:5432/database_name

# ---- Cache (Redis — ضروري لو عندك أكتر من worker process بالسيرفر) ----
# اتركه فاضي لو عندك worker وحدة بس (LocMemCache بيكفي حينها)
REDIS_URL=redis://127.0.0.1:6379/1

# ---- اختياري ----
DJANGO_CONN_MAX_AGE=60
DJANGO_HSTS_SECONDS=2592000
DJANGO_LOG_LEVEL=INFO

# ملاحظة: رقم واتساب العام (روابط wa.me) يُدار من لوحة التحكم فقط
# (إعدادات الموقع ← whatsapp_number) — مش من هون، لتفادي تعدّد المصادر.

# ---- WhatsApp Business Cloud API (أتمتة الرسائل — اختياري) ----
# اتركهم فاضيين: الأتمتة رح "تسجّل" الرسائل بالـ logs بدل ما تبعتها فعلياً،
# والموقع يشتغل عادي. عبّيهم لتفعيل الإرسال الحقيقي (شوف README).
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_API_VERSION=v21.0

# العنوان المطلق للموقع — يُستخدم لبناء روابط داخل رسائل واتساب من أوامر الإدارة
SITE_BASE_URL=https://lowcaloriesjordan.com
